/* QUBIC — Modern Light Theme Stylesheet */

QMainWindow, QWidget#MainWindow {
    background-color: #F6F5FA;
    color: #181524;
    font-family: "Inter", "Manrope", "Segoe UI", sans-serif;
    font-size: 13px;
}

QWidget {
    color: #181524;
    font-family: "Inter", "Manrope", "Segoe UI", sans-serif;
    font-size: 13px;
}

/* Sidebar */
QFrame#Sidebar {
    background-color: #EFEcf8;
    border-right: 1px solid #DCD6EC;
}

QLabel#BrandTitle {
    color: #181524;
    font-size: 19px;
    font-weight: 700;
    letter-spacing: 1px;
}

QLabel#BrandSubtitle {
    color: #625D75;
    font-size: 11px;
    font-weight: 500;
}

QLabel#VersionBadge {
    color: #625D75;
    background-color: #FFFFFF;
    border: 1px solid #DCD6EC;
    border-radius: 8px;
    padding: 4px 10px;
    font-size: 11px;
}

QPushButton#NavButton {
    background-color: transparent;
    color: #625D75;
    border: 1px solid transparent;
    border-radius: 10px;
    padding: 11px 14px;
    text-align: left;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#NavButton:hover {
    background-color: #FFFFFF;
    color: #181524;
}

QPushButton#NavButton[active="true"] {
    background-color: rgba(149, 101, 255, 0.14);
    color: #6C3CE9;
    border: 1px solid #9565FF;
}

/* Page Typography */
QLabel#PageTitle {
    color: #181524;
    font-size: 22px;
    font-weight: 700;
}

QLabel#PageSubtitle {
    color: #625D75;
    font-size: 13px;
}

QLabel#SectionTitle {
    color: #181524;
    font-size: 14px;
    font-weight: 700;
}

QLabel#FieldLabel {
    color: #181524;
    font-size: 12px;
    font-weight: 600;
}

QLabel#HintLabel {
    color: #625D75;
    font-size: 11px;
}

QLabel#WarningLabel {
    color: #B45309;
    background-color: #FEF3C7;
    border: 1px solid #F59E0B;
    border-radius: 8px;
    padding: 8px 10px;
    font-size: 11px;
}

QLabel#ErrorLabel {
    color: #E11D48;
    font-size: 11px;
    font-weight: 600;
}

/* Cards and Panels */
QFrame#Card, QFrame#PreviewCard, QFrame#HistoryCard, QFrame#TemplateCard {
    background-color: #FFFFFF;
    border: 1px solid #DCD6EC;
    border-radius: 14px;
}

QFrame#TemplateCard:hover, QFrame#HistoryCard:hover {
    border: 1px solid #9565FF;
}

QFrame#PreviewSurface {
    background-color: #F6F5FA;
    border: 1px solid #DCD6EC;
    border-radius: 12px;
}

/* Inputs */
QLineEdit, QPlainTextEdit, QComboBox, QSpinBox {
    background-color: #F9F8FC;
    color: #181524;
    border: 1px solid #DCD6EC;
    border-radius: 8px;
    padding: 8px 11px;
    selection-background-color: #9565FF;
    selection-color: #FFFFFF;
}

QLineEdit:focus, QPlainTextEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 1px solid #9565FF;
    background-color: #FFFFFF;
}

QLineEdit[invalid="true"] {
    border: 1px solid #E11D48;
}

QComboBox::drop-down {
    border: none;
    width: 26px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #181524;
    border: 1px solid #DCD6EC;
    selection-background-color: #9565FF;
    selection-color: #FFFFFF;
    outline: 0;
    padding: 4px;
}

/* Buttons */
QPushButton#PrimaryButton {
    background-color: #9565FF;
    color: #FFFFFF;
    border: 1px solid #7E4CE8;
    border-radius: 9px;
    padding: 10px 18px;
    font-weight: 700;
    font-size: 13px;
}

QPushButton#PrimaryButton:hover {
    background-color: #8350F5;
}

QPushButton#SecondaryButton {
    background-color: #F6F5FA;
    color: #181524;
    border: 1px solid #DCD6EC;
    border-radius: 9px;
    padding: 8px 14px;
    font-weight: 600;
}

QPushButton#SecondaryButton:hover {
    border: 1px solid #9565FF;
    background-color: #EFEcf8;
}

QPushButton#DangerButton {
    background-color: #FFE4E6;
    color: #E11D48;
    border: 1px solid #FDA4AF;
    border-radius: 9px;
    padding: 8px 14px;
    font-weight: 600;
}

QPushButton#DangerButton:hover {
    background-color: #FECDD3;
    border: 1px solid #E11D48;
}

QPushButton#TypeChip, QPushButton#StyleChip {
    background-color: #F6F5FA;
    color: #625D75;
    border: 1px solid #DCD6EC;
    border-radius: 8px;
    padding: 7px 12px;
    font-weight: 600;
    font-size: 12px;
}

QPushButton#TypeChip:hover, QPushButton#StyleChip:hover {
    color: #181524;
    border: 1px solid #9565FF;
}

QPushButton#TypeChip:checked, QPushButton#StyleChip:checked,
QPushButton#TypeChip[active="true"], QPushButton#StyleChip[active="true"] {
    background-color: rgba(149, 101, 255, 0.15);
    color: #6C3CE9;
    border: 1px solid #9565FF;
}

/* Checkboxes & Sliders */
QCheckBox {
    color: #181524;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 17px;
    height: 17px;
    border-radius: 4px;
    border: 1px solid #DCD6EC;
    background-color: #FFFFFF;
}

QCheckBox::indicator:checked {
    background-color: #9565FF;
    border: 1px solid #7E4CE8;
}

QSlider::groove:horizontal {
    height: 6px;
    background: #EFEcf8;
    border: 1px solid #DCD6EC;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: #9565FF;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #FFFFFF;
    border: 2px solid #9565FF;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 8px;
}

QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollBar:vertical {
    background: #F6F5FA;
    width: 8px;
    margin: 2px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #DCD6EC;
    min-height: 28px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #9565FF;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QFrame#NotificationBanner {
    background-color: #FFFFFF;
    border: 1px solid #9565FF;
    border-radius: 10px;
}

QToolTip {
    background-color: #FFFFFF;
    color: #181524;
    border: 1px solid #9565FF;
    padding: 6px 8px;
    border-radius: 6px;
}
